# Runtime de la app (Prisma en Next.js) — pooler
DATABASE_URL="url"

# CLI de Prisma (migrate, db pull, generate) — conexión directa
DIRECT_URL="url"

# Better Auth
# Secreto de cifrado (mín. 32 caracteres). Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
# URL base de la app (en local)
BETTER_AUTH_URL="http://localhost:3000"
