// Prisma schema for Supabase Postgres
// Connection URLs are configured in prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ============ BETTER AUTH ============
model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  accountType   AccountType @default(player) // rol global de plataforma
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships ClubMembership[]
  player      Player?

  @@unique([email])
  @@map("user")
}

// Tipo de cuenta a nivel plataforma
enum AccountType {
  player // se inscribe a torneos/ligas, ve sus partidos (fase futura)
  club_staff // opera uno o más clubs
  super_admin // administración de la plataforma
}

// ... Session, Account, Verification igual que los tienes ...

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============ NÚCLEO / TENANT ============
model Club {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Mexico_City")
  // antes en settings JSON, ahora explícito:
  email     String?
  phone     String?
  address   String?
  city      String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ClubMembership[]
  courts      Court[]
  players     Player[]
  leagues     League[]
  tournaments Tournament[]
  matches     Match[]

  @@map("club")
}

model ClubMembership {
  clubId    String
  userId    String
  role      ClubRole
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
  @@map("club_membership")
}

// Rol DENTRO de un club concreto
enum ClubRole {
  owner // dueño, control total incl. facturación y miembros
  admin // gestiona ligas, torneos, jugadores
  staff // captura resultados, opera en cancha
  viewer // solo lectura
}

model Court {
  id        String       @id @default(uuid())
  clubId    String
  name      String
  surface   CourtSurface @default(artificial_grass)
  isIndoor  Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  club         Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  matches      Match[]
  availability CourtAvailability[]

  @@index([clubId])
  @@map("court")
}

enum CourtSurface {
  artificial_grass
  concrete
  synthetic
  glass
}

// Horarios de disponibilidad por cancha (reemplaza un settings JSON de horarios)
model CourtAvailability {
  id        String @id @default(uuid())
  courtId   String
  dayOfWeek Int    @db.SmallInt // 0=domingo ... 6=sábado
  openTime  String // formato "HH:MM"
  closeTime String

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, dayOfWeek])
  @@map("court_availability")
}

// ============ JUGADORES ============
model Player {
  id           String     @id @default(uuid())
  clubId       String
  userId       String?    @unique
  fullName     String
  email        String?
  phone        String?
  gender       Gender?
  birthDate    DateTime?  @db.Date
  // nivel/categoría del jugador, antes candidato a JSON:
  skillLevel   SkillLevel @default(unranked)
  dominantHand Hand?
  createdAt    DateTime   @default(now())

  club                Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user                User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  leagueRegistrations LeagueRegistration[]
  teamMemberships     TournamentTeamMember[]
  matchSidePlayers    MatchSidePlayer[]

  @@index([clubId])
  @@map("player")
}

enum Gender {
  M
  F
  X
}

enum SkillLevel {
  unranked
  first // 1ra fuerza
  second
  third
  fourth
  fifth
  sixth
}

enum Hand {
  left
  right
}

// ============ LIGAS ============
model League {
  id        String         @id @default(uuid())
  clubId    String
  name      String
  format    LeagueFormat
  // individual: jugadores sueltos con parejas rotativas en grupos de 4.
  // pairs: parejas fijas inscritas (fase futura).
  playKind  LeaguePlayKind @default(individual)
  status    LeagueStatus   @default(draft)
  startDate DateTime?      @db.Date
  endDate   DateTime?      @db.Date
  createdAt DateTime       @default(now())

  club          Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  scoringConfig LeagueScoringConfig?
  rounds        LeagueRound[]
  registrations LeagueRegistration[]
  standings     LeagueStanding[]
  matches       Match[]

  @@index([clubId, status])
  @@map("league")
}

enum LeagueFormat {
  round_robin
  divisions
  ladder
}

enum LeaguePlayKind {
  individual // jugadores sueltos, parejas rotativas en grupos de 4
  pairs // parejas fijas inscritas
}

enum LeagueStatus {
  draft
  active
  finished
  archived
}

// Reemplaza scoringRules JSON con campos concretos.
// El ranking se decide por sets ganados, no por puntos de victoria.
model LeagueScoringConfig {
  leagueId    String             @id
  bestOfSets  Int                @default(3) @db.SmallInt // mejor de 3 / mejor de 1
  goldenPoint Boolean            @default(true) // punto de oro en deuce
  tiebreakAt  Int                @default(6) @db.SmallInt // games para tie-break
  // criterios de desempate, en orden de prioridad (por sets primero)
  tiebreaker1 StandingTiebreaker @default(set_diff)
  tiebreaker2 StandingTiebreaker @default(sets_won)
  tiebreaker3 StandingTiebreaker @default(game_diff)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@map("league_scoring_config")
}

enum StandingTiebreaker {
  head_to_head
  set_diff
  game_diff
  sets_won
  games_won
}

model LeagueRound {
  id            String            @id @default(uuid())
  leagueId      String
  roundNumber   Int
  name          String?
  scheduledDate DateTime?         @db.Date
  // draft: solo visible en el panel. published: visible en la página pública.
  // closed: cerrada/finalizada, ya no admite cambios de nombre/fecha.
  status        LeagueRoundStatus @default(draft)

  league     League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  matches    Match[]
  groupSlots LeagueGroupSlot[]

  @@unique([leagueId, roundNumber])
  @@map("league_round")
}

enum LeagueRoundStatus {
  draft
  published
  closed
}

model LeagueRegistration {
  id        String             @id @default(uuid())
  leagueId  String
  playerId  String
  division  String?
  seed      Int?
  status    RegistrationStatus @default(active)
  createdAt DateTime           @default(now())

  league     League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player     Player            @relation(fields: [playerId], references: [id])
  standing   LeagueStanding?
  groupSlots LeagueGroupSlot[]

  @@unique([leagueId, playerId])
  @@index([leagueId])
  @@map("league_registration")
}

enum RegistrationStatus {
  active
  withdrawn
}

// ============ TORNEOS ============
model Tournament {
  id                   String           @id @default(uuid())
  clubId               String
  name                 String
  status               TournamentStatus @default(draft)
  startDate            DateTime?        @db.Date
  endDate              DateTime?        @db.Date
  // antes candidatos a settings JSON:
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  location             String?
  description          String?
  createdAt            DateTime         @default(now())

  club       Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  categories TournamentCategory[]

  @@index([clubId, status])
  @@map("tournament")
}

enum TournamentStatus {
  draft
  registration_open
  in_progress
  finished
  archived
}

model TournamentCategory {
  id           String         @id @default(uuid())
  tournamentId String
  clubId       String // denormalizado para filtros por tenant
  name         String
  gender       CategoryGender @default(mixed)
  skillLevel   SkillLevel     @default(unranked)
  drawType     DrawType
  maxTeams     Int?
  bestOfSets   Int            @default(3) @db.SmallInt
  // tarifa, antes en settings JSON:
  entryFee     Decimal?       @db.Decimal(10, 2)
  currency     String         @default("MXN")

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams      TournamentTeam[]
  matches    Match[]

  @@unique([tournamentId, name])
  @@index([clubId])
  @@map("tournament_category")
}

enum CategoryGender {
  M
  F
  mixed
}

enum DrawType {
  single_elim
  double_elim
  round_robin
  groups_playoff
}

model TournamentTeam {
  id         String     @id @default(uuid())
  categoryId String
  clubId     String // denormalizado para tenant
  name       String?
  seed       Int?
  status     TeamStatus @default(registered)
  createdAt  DateTime   @default(now())

  category TournamentCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  members  TournamentTeamMember[]
  sides    MatchSide[]

  @@index([categoryId])
  @@index([clubId])
  @@map("tournament_team")
}

enum TeamStatus {
  registered
  confirmed
  withdrawn
}

model TournamentTeamMember {
  teamId   String
  playerId String

  team   TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player         @relation(fields: [playerId], references: [id])

  @@id([teamId, playerId])
  @@map("tournament_team_member")
}

// ============ PARTIDOS ============
model Match {
  id          String       @id @default(uuid())
  clubId      String
  contextType MatchContext

  leagueId      String?
  leagueRoundId String?

  categoryId   String?
  bracketRound String?

  // En ligas: grupo/nivel del partido. 1 = mejores, números mayores = niveles
  // inferiores. Ordena los partidos dentro de una jornada.
  groupNumber Int? @db.SmallInt

  // En ligas individuales: orden del set dentro del grupo (1..3) con parejas
  // rotativas. Null en el resto de contextos.
  intraGroupOrder Int? @db.SmallInt

  courtId     String?
  scheduledAt DateTime?
  status      MatchStatus @default(scheduled)
  winnerSide  Side?
  createdAt   DateTime    @default(now())

  club        Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  league      League?             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueRound LeagueRound?        @relation(fields: [leagueRoundId], references: [id], onDelete: SetNull)
  category    TournamentCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  court       Court?              @relation(fields: [courtId], references: [id], onDelete: SetNull)
  sides       MatchSide[]
  sets        MatchSet[]

  @@index([leagueId])
  @@index([categoryId])
  @@index([clubId, scheduledAt])
  @@index([leagueRoundId, groupNumber])
  @@map("match")
}

enum MatchContext {
  league
  tournament
}

enum MatchStatus {
  scheduled
  in_progress
  suspended
  finished
  walkover
  cancelled
}

enum Side {
  A
  B
}

model MatchSide {
  id      String  @id @default(uuid())
  matchId String
  side    Side
  teamId  String?

  match   Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team    TournamentTeam?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  players MatchSidePlayer[]

  @@unique([matchId, side])
  @@map("match_side")
}

model MatchSidePlayer {
  matchSideId String
  playerId    String

  matchSide MatchSide @relation(fields: [matchSideId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id])

  @@id([matchSideId, playerId])
  @@map("match_side_player")
}

model MatchSet {
  matchId   String
  setNumber Int    @db.SmallInt
  gamesA    Int    @db.SmallInt
  gamesB    Int    @db.SmallInt
  tiebreakA Int?   @db.SmallInt
  tiebreakB Int?   @db.SmallInt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, setNumber])
  @@map("match_set")
}

// ============ RANKING (precalculado) ============
model LeagueStanding {
  leagueId       String
  registrationId String   @unique
  division       String?
  matchesPlayed  Int      @default(0)
  wins           Int      @default(0)
  losses         Int      @default(0)
  setsFor        Int      @default(0) // sets ganados — criterio principal del ranking
  setsAgainst    Int      @default(0)
  gamesFor       Int      @default(0)
  gamesAgainst   Int      @default(0)
  updatedAt      DateTime @updatedAt

  league       League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  registration LeagueRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@id([leagueId, registrationId])
  @@index([leagueId, division, setsFor])
  @@map("league_standing")
}

// Pertenencia a grupo de un jugador EN una jornada (formato individual).
// Hace explícito el grupo de cada jornada y registra el resultado del grupo
// (sets ganados, posición y movimiento) para generar la jornada siguiente.
model LeagueGroupSlot {
  id             String         @id @default(uuid())
  roundId        String
  groupNumber    Int            @db.SmallInt // 1 = grupo más alto
  registrationId String
  // Pase de lista: si el jugador llegó al partido. Cuando es `absent`, su
  // participación la cubre un suplente externo (substituteName) cuyos puntos
  // no cuentan; el jugador pierde la jornada (último del grupo, desciende).
  attendance     SlotAttendance @default(pending)
  substituteName String? // nombre del suplente externo que jugó en su lugar
  // Se llenan al cerrar la jornada:
  setsWon        Int?           @db.SmallInt
  rankInGroup    Int?           @db.SmallInt // 1..4
  movement       GroupMovement?

  round        LeagueRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registration LeagueRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([roundId, registrationId])
  @@index([roundId, groupNumber])
  @@map("league_group_slot")
}

enum SlotAttendance {
  pending // sin pasar lista todavía
  present // llegó al partido
  absent // no llegó; lo cubre un suplente y pierde la jornada
}

enum GroupMovement {
  up // sube de grupo (ganador)
  down // baja de grupo (último)
  stay // se mantiene
}
