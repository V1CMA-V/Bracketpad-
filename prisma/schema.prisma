// Prisma schema for Supabase Postgres
// Connection URLs are configured in prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ============ BETTER AUTH ============
model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  accountType   AccountType @default(player) // rol global de plataforma
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships ClubMembership[]
  player      Player?

  @@unique([email])
  @@map("user")
}

// Tipo de cuenta a nivel plataforma
enum AccountType {
  player // se inscribe a torneos/ligas, ve sus partidos (fase futura)
  club_staff // opera uno o más clubs
  super_admin // administración de la plataforma
}

// ... Session, Account, Verification igual que los tienes ...

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============ NÚCLEO / TENANT ============
model Club {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Mexico_City")
  // antes en settings JSON, ahora explícito:
  email     String?
  phone     String?
  address   String?
  city      String?
  logoUrl   String?
  // Identidad ampliada (editable desde Ajustes del club):
  legalName   String? // razón social
  taxId       String? // RFC
  foundedYear Int?    @db.SmallInt // año de fundación
  description String? // descripción / eslogan público
  website     String?
  instagram   String? // usuario sin la @
  state       String? // estado / provincia
  postalCode  String? // código postal
  country     String? @default("México")
  // Coordenadas para el mapa de la página pública (editable desde Ajustes):
  latitude    Float? // latitud (WGS84)
  longitude   Float? // longitud (WGS84)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ClubMembership[]
  courts      Court[]
  players     Player[]
  coaches     Coach[]
  leagues     League[]
  tournaments Tournament[]
  matches     Match[]
  hours       ClubHours[]
  reservations CourtReservation[]
  classPricing ClubClassPricing?
  courtRates   ClubCourtRate[]

  @@map("club")
}

// Coach del club que imparte clases. Datos básicos: las clases se reservan desde
// la programación (ver `CourtReservation` con `kind = class`).
model Coach {
  id        String   @id @default(uuid())
  clubId    String
  fullName  String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  club         Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  reservations CourtReservation[]

  @@index([clubId])
  @@map("coach")
}

// Tarifario de clases del club: precio por clase según cuántos jugadores asisten
// (1 a 4). Lo edita el club en Ajustes y prerellena el precio al reservar una
// clase. Cada importe es opcional (null = sin definir para ese nº de jugadores).
model ClubClassPricing {
  clubId   String   @id
  price1   Decimal? @db.Decimal(10, 2)
  price2   Decimal? @db.Decimal(10, 2)
  price3   Decimal? @db.Decimal(10, 2)
  price4   Decimal? @db.Decimal(10, 2)
  currency String   @default("MXN")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("club_class_pricing")
}

// Tarifas de renta de pista (juego libre). Cada regla cubre una franja horaria
// y un conjunto de días con un precio por hora — así un club puede cobrar
// distinto por la mañana, por la tarde o el fin de semana. Se editan en Ajustes
// y se muestran en la página pública del club.
model ClubCourtRate {
  id        String   @id @default(uuid())
  clubId    String
  label     String? // etiqueta opcional, p.ej. "Mañana entre semana"
  days      Int[] // días que cubre: 0=domingo … 6=sábado
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  price     Decimal  @db.Decimal(10, 2) // precio por hora
  currency  String   @default("MXN")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_court_rate")
}

// Horario de apertura/cierre del club por día de la semana ("HH:MM"). Define el
// rango horario de la programación de pistas, que puede variar entre semana y
// fin de semana. Un día sin fila = cerrado ese día.
model ClubHours {
  clubId    String
  dayOfWeek Int    @db.SmallInt // 0=domingo … 6=sábado
  openTime  String
  closeTime String

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, dayOfWeek])
  @@map("club_hours")
}

model ClubMembership {
  clubId    String
  userId    String
  role      ClubRole
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
  @@map("club_membership")
}

// Rol DENTRO de un club concreto
enum ClubRole {
  owner // dueño, control total incl. facturación y miembros
  admin // gestiona ligas, torneos, jugadores
  staff // captura resultados, opera en cancha
  viewer // solo lectura
}

model Court {
  id        String       @id @default(uuid())
  clubId    String
  name      String
  surface   CourtSurface @default(artificial_grass)
  isIndoor  Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  club         Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  matches      Match[]
  availability CourtAvailability[]
  reservations CourtReservation[]

  @@index([clubId])
  @@map("court")
}

// ============ RESERVAS DE PISTA (uso privado del club) ============
// Apartado de una cancha para juego libre de jugadores (no liga ni torneo). El
// club bloquea la pista un rato (60/90 min…) a nombre de quien reserva y lleva
// el control de cobro: precio total, lo abonado y la moneda (el saldo se
// calcula). No requiere nombrar a todos los participantes, solo al titular.
model CourtReservation {
  id              String @id @default(uuid())
  clubId          String
  courtId         String
  holderName      String // a nombre de quién es la reserva (titular)
  phone           String? // contacto para confirmar o avisar cancelaciones
  startAt         DateTime // inicio de la reserva
  durationMinutes Int      @db.SmallInt // cuánto aparta la cancha (60, 90…)
  status          ReservationStatus @default(confirmed)
  // Tipo de reserva: juego libre (por defecto) o clase con coach. En una clase
  // se nombra al coach y cuántos jugadores asisten (1–4), y el precio se
  // prerellena desde el tarifario del club (`ClubClassPricing`).
  kind        ReservationKind @default(free_play)
  coachId     String?
  playerCount Int?            @db.SmallInt
  // Cobro: precio total acordado y lo abonado hasta ahora. `paymentStatus`
  // distingue pagado / pendiente / abono parcial; el saldo = price − amountPaid.
  paymentStatus ReservationPaymentStatus @default(pending)
  price         Decimal?                 @db.Decimal(10, 2)
  amountPaid    Decimal                  @default(0) @db.Decimal(10, 2)
  currency      String                   @default("MXN")
  notes         String?
  createdAt     DateTime @default(now())

  club  Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  court Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  coach Coach? @relation(fields: [coachId], references: [id], onDelete: SetNull)

  @@index([clubId, startAt])
  @@index([courtId, startAt])
  @@index([coachId, startAt])
  @@map("court_reservation")
}

enum ReservationStatus {
  confirmed
  cancelled
}

enum ReservationKind {
  free_play // juego libre (reserva normal de pista)
  class // clase con coach
}

enum ReservationPaymentStatus {
  paid // pagado por completo
  pending // sin abonar nada todavía
  partial // abono parcial (queda saldo)
}

enum CourtSurface {
  artificial_grass
  concrete
  synthetic
  glass
}

// Horarios de disponibilidad por cancha (reemplaza un settings JSON de horarios)
model CourtAvailability {
  id        String @id @default(uuid())
  courtId   String
  dayOfWeek Int    @db.SmallInt // 0=domingo ... 6=sábado
  openTime  String // formato "HH:MM"
  closeTime String

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, dayOfWeek])
  @@map("court_availability")
}

// ============ JUGADORES ============
model Player {
  id           String     @id @default(uuid())
  clubId       String
  userId       String?    @unique
  fullName     String
  email        String?
  phone        String?
  gender       Gender?
  birthDate    DateTime?  @db.Date
  // nivel/categoría del jugador, antes candidato a JSON:
  skillLevel   SkillLevel @default(unranked)
  dominantHand Hand?
  createdAt    DateTime   @default(now())

  club                Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user                User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  leagueRegistrations LeagueRegistration[]   @relation("LeagueRegPlayer")
  // Inscripciones donde este jugador es el segundo de la pareja (ligas pairs).
  leaguePartnerRegistrations LeagueRegistration[] @relation("LeagueRegPartner")
  teamMemberships     TournamentTeamMember[]
  matchSidePlayers    MatchSidePlayer[]

  @@index([clubId])
  @@map("player")
}

enum Gender {
  M
  F
  X
}

enum SkillLevel {
  unranked
  first // 1ra fuerza
  second
  third
  fourth
  fifth
  sixth
}

enum Hand {
  left
  right
}

// ============ LIGAS ============
model League {
  id        String         @id @default(uuid())
  clubId    String
  name      String
  format    LeagueFormat
  // individual: jugadores sueltos con parejas rotativas en grupos de 4.
  // pairs: parejas fijas inscritas (fase futura).
  playKind  LeaguePlayKind @default(individual)
  status    LeagueStatus   @default(draft)
  startDate DateTime?      @db.Date
  endDate   DateTime?      @db.Date
  // Número de jornadas previstas de la temporada (informativo: la publicidad
  // suele anunciarlo, p. ej. «6 jornadas»). Null = sin definir.
  totalRounds  Int?         @db.SmallInt
  // Calendario recurrente de juego: días de la semana (0=domingo … 6=sábado) y
  // horarios fijos en formato "HH:MM" (p. ej. jueves a las 19:00 y 20:30).
  playWeekdays Int[]
  playTimes    String[]
  // Premios de la liga (texto libre): qué se gana al terminar primero en la
  // clasificación, premios por cancha/grupo, etc. Lo redacta el club.
  prizes    String?
  // Costo de inscripción a la liga: lo que paga un jugador para entrar.
  // Null = gratuita / sin definir. La moneda acompaña al importe.
  entryFee  Decimal?       @db.Decimal(10, 2)
  currency  String         @default("MXN")
  createdAt DateTime       @default(now())

  club          Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  scoringConfig LeagueScoringConfig?
  rounds        LeagueRound[]
  registrations LeagueRegistration[]
  standings     LeagueStanding[]
  matches       Match[]

  @@index([clubId, status])
  @@map("league")
}

enum LeagueFormat {
  round_robin
  divisions
  ladder
}

enum LeaguePlayKind {
  individual // jugadores sueltos, parejas rotativas en grupos de 4
  pairs // parejas fijas inscritas
}

enum LeagueStatus {
  draft
  active
  finished
  archived
}

// Reemplaza scoringRules JSON con campos concretos.
// El ranking se decide por sets ganados, no por puntos de victoria.
model LeagueScoringConfig {
  leagueId    String             @id
  bestOfSets  Int                @default(3) @db.SmallInt // mejor de 3 / mejor de 1
  goldenPoint Boolean            @default(true) // punto de oro en deuce
  tiebreakAt  Int                @default(6) @db.SmallInt // games para tie-break
  // Sanción por inasistencia: juegos en contra que se asignan a quien no se
  // presenta a su jornada. Cada club fija su política (9 por defecto = forfeit
  // de los 3 sets; otros usan 6, 0, etc.). El jugador siempre pierde la jornada.
  noShowGamesAgainst Int         @default(9) @db.SmallInt
  // Criterio principal de la clasificación: por sets ganados (defecto) o
  // únicamente por juegos ganados (ligas que solo cuentan juegos).
  rankingBy   LeagueRankingBasis @default(sets)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@map("league_scoring_config")
}

enum LeagueRankingBasis {
  sets // ranking por sets ganados (y juegos como desempate)
  games // ranking únicamente por juegos ganados
  both // ranking por sets ganados, mostrando sets y juegos en la tabla
}

model LeagueRound {
  id            String            @id @default(uuid())
  leagueId      String
  roundNumber   Int
  name          String?
  scheduledDate DateTime?         @db.Date
  // draft: solo visible en el panel. published: visible en la página pública.
  // closed: cerrada/finalizada, ya no admite cambios de nombre/fecha.
  status        LeagueRoundStatus @default(draft)
  // Jornada previa («de nivel»): se juega para observar a los jugadores y
  // acomodar los grupos, pero sus resultados NO cuentan para la clasificación
  // general de la liga. Sigue admitiendo ascenso/descenso para armar la
  // siguiente jornada.
  isPreliminary Boolean           @default(false)

  league     League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  matches    Match[]
  groupSlots LeagueGroupSlot[]

  @@unique([leagueId, roundNumber])
  @@map("league_round")
}

enum LeagueRoundStatus {
  draft
  published
  closed
}

model LeagueRegistration {
  id        String             @id @default(uuid())
  leagueId  String
  playerId  String
  // Segundo jugador de la pareja en ligas `pairs`. Null en ligas individuales.
  partnerPlayerId String?
  division  String?
  seed      Int?
  status    RegistrationStatus @default(active)
  createdAt DateTime           @default(now())

  league        League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player        Player            @relation("LeagueRegPlayer", fields: [playerId], references: [id])
  partnerPlayer Player?           @relation("LeagueRegPartner", fields: [partnerPlayerId], references: [id])
  standing   LeagueStanding?
  groupSlots LeagueGroupSlot[]

  @@unique([leagueId, playerId])
  @@index([leagueId])
  @@map("league_registration")
}

enum RegistrationStatus {
  active
  withdrawn
}

// ============ TORNEOS ============
model Tournament {
  id                   String           @id @default(uuid())
  clubId               String
  name                 String
  status               TournamentStatus @default(draft)
  startDate            DateTime?        @db.Date
  endDate              DateTime?        @db.Date
  // antes candidatos a settings JSON:
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  location             String?
  description          String?
  createdAt            DateTime         @default(now())

  club       Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  categories TournamentCategory[]

  @@index([clubId, status])
  @@map("tournament")
}

enum TournamentStatus {
  draft
  registration_open
  in_progress
  finished
  archived
}

model TournamentCategory {
  id           String         @id @default(uuid())
  tournamentId String
  clubId       String // denormalizado para filtros por tenant
  name         String
  gender       CategoryGender @default(mixed)
  skillLevel   SkillLevel     @default(unranked)
  drawType     DrawType
  maxTeams     Int?
  bestOfSets   Int            @default(3) @db.SmallInt
  goldenPoint  Boolean        @default(true) // punto de oro en deuce
  tiebreakAt   Int            @default(6) @db.SmallInt // juegos para tie-break
  // Configuración de la fase de grupos (solo aplica con drawType = groups_playoff):
  // cuántas parejas integran cada grupo y cuántas avanzan a la fase final.
  teamsPerGroup   Int? @db.SmallInt
  advancePerGroup Int? @db.SmallInt
  // Premio de la categoría (texto libre): no es lo mismo ganar 5ta que 1ra, así
  // que cada categoría redacta su propio premio (efectivo, trofeo, productos…).
  prize        String?
  // tarifa, antes en settings JSON:
  entryFee     Decimal?       @db.Decimal(10, 2)
  currency     String         @default("MXN")

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams      TournamentTeam[]
  matches    Match[]

  @@unique([tournamentId, name])
  @@index([clubId])
  @@map("tournament_category")
}

enum CategoryGender {
  M
  F
  mixed
}

enum DrawType {
  single_elim
  double_elim
  round_robin
  groups_playoff
}

model TournamentTeam {
  id         String     @id @default(uuid())
  categoryId String
  clubId     String // denormalizado para tenant
  name       String?
  seed       Int?
  status     TeamStatus @default(registered)
  // Grupo asignado en la fase de grupos (1 = primer grupo). Null hasta que se
  // generan los grupos; se reparte por siembra serpenteante según el cabeza de
  // serie. Al borrar/regenerar los grupos vuelve a null.
  groupNumber Int?      @db.SmallInt
  createdAt  DateTime   @default(now())

  category TournamentCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  members  TournamentTeamMember[]
  sides    MatchSide[]

  @@index([categoryId])
  @@index([clubId])
  @@map("tournament_team")
}

enum TeamStatus {
  registered
  confirmed
  withdrawn
}

model TournamentTeamMember {
  teamId   String
  playerId String

  team   TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player         @relation(fields: [playerId], references: [id])

  @@id([teamId, playerId])
  @@map("tournament_team_member")
}

// ============ PARTIDOS ============
model Match {
  id          String       @id @default(uuid())
  clubId      String
  contextType MatchContext

  leagueId      String?
  leagueRoundId String?

  categoryId   String?
  bracketRound String?

  // En ligas: grupo/nivel del partido. 1 = mejores, números mayores = niveles
  // inferiores. Ordena los partidos dentro de una jornada.
  groupNumber Int? @db.SmallInt

  // En ligas individuales: orden del set dentro del grupo (1..3) con parejas
  // rotativas. Null en el resto de contextos.
  intraGroupOrder Int? @db.SmallInt

  courtId     String?
  scheduledAt DateTime?
  // Minutos que el partido aparta la cancha (duración). En los grupos de liga
  // define cuánto dura cada ronda y, por tanto, el escalonado de las rondas
  // siguientes. Null = duración por defecto.
  durationMinutes Int? @db.SmallInt
  status      MatchStatus @default(scheduled)
  winnerSide  Side?
  createdAt   DateTime    @default(now())

  club        Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  league      League?             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueRound LeagueRound?        @relation(fields: [leagueRoundId], references: [id], onDelete: Cascade)
  category    TournamentCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  court       Court?              @relation(fields: [courtId], references: [id], onDelete: SetNull)
  sides       MatchSide[]
  sets        MatchSet[]

  @@index([leagueId])
  @@index([categoryId])
  @@index([clubId, scheduledAt])
  @@index([leagueRoundId, groupNumber])
  @@map("match")
}

enum MatchContext {
  league
  tournament
}

enum MatchStatus {
  scheduled
  in_progress
  suspended
  finished
  walkover
  cancelled
}

enum Side {
  A
  B
}

model MatchSide {
  id      String  @id @default(uuid())
  matchId String
  side    Side
  teamId  String?

  match   Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team    TournamentTeam?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  players MatchSidePlayer[]

  @@unique([matchId, side])
  @@map("match_side")
}

model MatchSidePlayer {
  matchSideId String
  playerId    String

  matchSide MatchSide @relation(fields: [matchSideId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id])

  @@id([matchSideId, playerId])
  @@map("match_side_player")
}

model MatchSet {
  matchId   String
  setNumber Int    @db.SmallInt
  gamesA    Int    @db.SmallInt
  gamesB    Int    @db.SmallInt
  tiebreakA Int?   @db.SmallInt
  tiebreakB Int?   @db.SmallInt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, setNumber])
  @@map("match_set")
}

// ============ RANKING (precalculado) ============
model LeagueStanding {
  leagueId       String
  registrationId String   @unique
  division       String?
  matchesPlayed  Int      @default(0)
  wins           Int      @default(0)
  losses         Int      @default(0)
  setsFor        Int      @default(0) // sets ganados — criterio principal del ranking
  setsAgainst    Int      @default(0)
  gamesFor       Int      @default(0)
  gamesAgainst   Int      @default(0)
  updatedAt      DateTime @updatedAt

  league       League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  registration LeagueRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@id([leagueId, registrationId])
  @@index([leagueId, division, setsFor])
  @@map("league_standing")
}

// Pertenencia a grupo de un jugador EN una jornada (formato individual).
// Hace explícito el grupo de cada jornada y registra el resultado del grupo
// (sets ganados, posición y movimiento) para generar la jornada siguiente.
model LeagueGroupSlot {
  id             String         @id @default(uuid())
  roundId        String
  groupNumber    Int            @db.SmallInt // 1 = grupo más alto
  registrationId String
  // Pase de lista: si el jugador llegó al partido. Cuando es `absent`, su
  // participación la cubre un suplente externo (substituteName) cuyos puntos
  // no cuentan; el jugador pierde la jornada (último del grupo, desciende).
  attendance     SlotAttendance @default(pending)
  substituteName String? // nombre del suplente externo que jugó en su lugar
  // Decisión manual del organizador cuando hay empate por el ascenso o el
  // descenso en el grupo: marca quién sube/baja. Solo se usa para resolver el
  // empate; se ignora cuando el puesto se decide solo por resultados.
  manualMovement GroupMovement?
  // Se llenan al cerrar la jornada:
  setsWon        Int?           @db.SmallInt
  rankInGroup    Int?           @db.SmallInt // 1..4
  movement       GroupMovement?

  round        LeagueRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registration LeagueRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([roundId, registrationId])
  @@index([roundId, groupNumber])
  @@map("league_group_slot")
}

enum SlotAttendance {
  pending // sin pasar lista todavía
  present // llegó al partido
  absent // no llegó; lo cubre un suplente y pierde la jornada
}

enum GroupMovement {
  up // sube de grupo (ganador)
  down // baja de grupo (último)
  stay // se mantiene
}
